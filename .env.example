# .env.example
# Copy this to .env:
#   cp .env.example .env
#
# DO NOT add AWS credentials — your Canvas/Learner Lab session provides them automatically.
# The only values you need to fill in are below.

# ── AWS region ─────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1

# ── S3 bucket name (the name you used in: aws s3 mb s3://your-name) ───────────
AWS_S3_BUCKET=your-unique-bucket-name

# ── SQS queue URL (printed when you ran: aws sqs create-queue) ────────────────
AWS_SQS_URL=

# ── Optional tuning ────────────────────────────────────────────────────────────
POLL_INTERVAL=3
SQS_BATCH_SIZE=10
N_SAMPLES=200
N_FEATURES=10
TEST_SIZE=0.2
RANDOM_SEED=42
