# .env.example
# Copy this to .env:
#   cp .env.example .env

# Fill in Values Below

# ── AWS region
AWS_REGION= us-east-1

# ── S3 bucket name (the name you used in: aws s3 mb s3://your-name)
AWS_S3_BUCKET= 

# ── SQS queue URL (printed when you ran: aws sqs create-queue) 
AWS_SQS_URL=

# ── Optional tuning of ML data
POLL_INTERVAL=3
SQS_BATCH_SIZE=10
N_SAMPLES=200
N_FEATURES=10
TEST_SIZE=0.2
RANDOM_SEED=42
